      "nodes": [
        {
          "t": "html",
          "html": "<p>Are your Eyes Always Irritated? There’s a Reason</p>",
          "transform": "uppercase",
          "id": "Po2KIIZRaV",
          "col": 0,
          "origin": "static",
          "hint": "kicker"
