      "nodes": [
        {
          "t": "html",
          "html": "<p>Let’s Stay Ahead of Your Child’s Vision</p>",
          "transform": "uppercase",
          "id": "V75X8Sv6ej",
          "col": 0,
          "origin": "static",
          "hint": "kicker"
        },
        {
          "t": "heading",
          "level": 3,
          "text": "Myopia Control for Growing Eyes",
          "html": "Myopia Control for Growing Eyes",
          "id": "FS19iMozJf",
          "col": 0,
          "origin": "static"
        },
        {
          "t": "html",
          "html": "<p>If your child’s prescription keeps changing, we can help slow progression and protect their long-term vision.</p><p>Using advanced treatment options tailored to your child’s needs, we focus on more than just helping them see clearly now; we’re helping set them up for the future.</p>",
          "id": "kMmxHwJuhr",
          "col": 0,
          "origin": "static"
